# ===== APP =====
NODE_ENV=production
APP_URL=https://perplexta.online
VITE_APP_URL=https://perplexta.online

# ===== DATABASE =====
DATABASE_URL=postgresql://user:pass@host:5432/perplexta?sslmode=require
SECURITY_DATABASE_URL=postgresql://user:pass@host:5432/perplexta_security?sslmode=require
MEDIA_DATABASE_URL=postgresql://user:pass@host:5432/perplexta_media?sslmode=require
LEDGER_DATABASE_URL=postgresql://user:pass@host:5432/perplexta_ledger?sslmode=require
EXTERNAL_DATABASE_URL=postgresql://user:pass@host:5432/perplexta_external?sslmode=require
DB_MAX_CONNECTIONS=20

# ===== SECURITY =====
JWT_SECRET=<generate-with-openssl-rand-hex-32>
CSRF_SECRET=<generate-with-openssl-rand-hex-32>
ADMIN_EMAIL=admin@perplexta.online
ADMIN_PASSWORD=<strong-password>
ALLOWED_ORIGINS=https://perplexta.online,https://www.perplexta.online

# ===== PERFORMANCE =====
REDIS_URL=redis://localhost:6379
BACKUP_DIR=/var/backups/perplexta
ENABLE_AUTO_BACKUP=true

# ===== EMAIL =====
MAILER_TYPE=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=noreply@perplexta.online
SMTP_PASSWORD=<app-password>
SENDER_NAME=Perplexta
SENDER_EMAIL=noreply@perplexta.online

# ===== RATE LIMITING =====
GLOBAL_RATE_LIMIT=100
AUTH_RATE_LIMIT=5
ADMIN_RATE_LIMIT=50
