# =============================================================================
# PERPLEXTA PLATFORM — PRODUCTION ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================

# Mandatory Cryptographic Secrets (>= 32 characters long)
JWT_SECRET=
ENCRYPTION_KEY=

# Server Identity & Admin Account Credentials
ADMIN_EMAIL=
ADMIN_PASSWORD=
APP_URL=
PUBLIC_APP_URL=
PORT=3000
NODE_ENV=production

# Database Connection URLs
DATABASE_URL=
LEDGER_DATABASE_URL=
SECURITY_DATABASE_URL=
MEDIA_DATABASE_URL=
EXTERNAL_DATABASE_URL=

# Unified Database Pool Sizes (Strict source of truth per database pool)
DB_CORE_MAX_POOL_SIZE=20
DB_LEDGER_MAX_POOL_SIZE=20
DB_SECURITY_MAX_POOL_SIZE=20
DB_MEDIA_MAX_POOL_SIZE=20
DB_EXTERNAL_MAX_POOL_SIZE=20
# Optional general fallback only
DB_MAX_CONNECTIONS=

# Database SSL & Security Policies
DB_SSL_REQUIRED=true
DB_SSL_REJECT_UNAUTHORIZED=true
DB_SSL_CA=
DB_SSL_CA_PATH=
STRICT_DB_SEGREGATION=true
ALLOW_CORE_FAILOVER=false

# PostgreSQL Docker Container Credentials
POSTGRES_PASSWORD=
POSTGRES_USER=perplexta
CORE_DB_NAME=perplexta_core
LEDGER_DB_NAME=perplexta_ledger
SECURITY_DB_NAME=perplexta_security

# Rate Limiting & Proxy Configuration
GLOBAL_RATE_LIMIT=300
AUTH_RATE_LIMIT=20
ADMIN_RATE_LIMIT=50
TRUST_PROXIES=
ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGINS=
CSRF_SECRET=

# AI Provider Keys
GEMINI_API_KEY=
SERPER_API_KEY=

# Payment Gateway Integrations
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_MODE=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Third-Party OAuth Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
APPLE_CLIENT_ID=
APPLE_PRIVATE_KEY=

# Cryptographic Token Signing Keys
SIGNING_KEY_ID=
SIGNING_PRIVATE_KEY=
SIGNING_PUBLIC_KEY=
SIGNING_PRIVATE_KEY_PATH=
SIGNING_PUBLIC_KEY_PATH=

# System Backup & Operations
BACKUP_DIR=
DEBUG_DB=false
ALLOWED_CHROME_EXTENSION_IDS=

# =============================================================================
# FRONTEND CLIENT ENVIRONMENT VARIABLES (BUNDLED IN PUBLIC CLIENT JAVASCRIPT)
# CRITICAL NOTICE: Variables starting with VITE_* are public and embedded
# inside client JS bundles. NEVER place private secrets or keys in VITE_* vars.
# =============================================================================
VITE_APP_URL=
# Must be restricted by Website HTTP Referrers in Google Cloud Console
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_CLIENT_ID=