{
	"appId": "com.perplexta.app",
	"appName": "PERPLEXTA",
	"webDir": "dist",
	"server": {
		"androidScheme": "https",
		"cleartext": false
	},
	"android": {
		"allowMixedContent": false,
		"captureInput": true,
		"webContentsDebuggingEnabled": false,
		"backgroundColor": "#0d1117"
	},
	"ios": {
		"contentInset": "automatic",
		"preferredContentMode": "mobile",
		"scheme": "Perplexta",
		"backgroundColor": "#0d1117"
	},
	"plugins": {
		"PushNotifications": {
			"presentationOptions": [
				"badge",
				"sound",
				"alert"
			]
		}
	}
}
